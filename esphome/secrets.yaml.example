# Copy to /opt/stacks/esphome/config/secrets.yaml on VM 100 and fill in.
# Never commit the filled-in copy — .gitignore covers secrets.yaml.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Over-the-air update password. Choose your own.
ota_password: "YOUR_OTA_PASSWORD"

# Home Assistant API encryption key — 32 random bytes, base64.
# Generate with: openssl rand -base64 32
api_key: "YOUR_BASE64_API_ENCRYPTION_KEY"
