# Hub public key — shown at /settings or GET /api/beszel/getkey. Not a secret.
BESZEL_KEY="ssh-ed25519 AAAA..."
# Per-system registration tokens (fingerprints collection, one per system).
# Hub-scoped and revocable; they grant nothing outside beszel.
VM100_AGENT_TOKEN=00000000-0000-0000-0000-000000000000
VM200_AGENT_TOKEN=00000000-0000-0000-0000-000000000000
